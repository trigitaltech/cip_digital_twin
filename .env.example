# PostgreSQL Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=metallurgy_db
# Host port mapping (use 5433 if host already runs PostgreSQL on 5432)
POSTGRES_PORT=5433

# Application Database URL for local development outside Docker
DATABASE_URL=postgresql://user:password@localhost:5433/metallurgy_db

# Frontend Web Port (Default 3000 to avoid conflicting with existing reverse proxies on 80)
FRONTEND_PORT=3000

